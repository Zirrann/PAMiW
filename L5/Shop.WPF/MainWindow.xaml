<Window x:Class="Shop.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shop.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Margin="20">
        <!-- Nagłówek -->
        <TextBlock Text="Witaj w aplikacji!" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20" Foreground="#2D2D2D"/>

        <!-- Przycisk do przejścia do produktów -->
        <Button Content="Przejdź do produktów" Command="{Binding NavigateToProductsCommand}" HorizontalAlignment="Center" Width="250" Height="50" Margin="0,20" Background="#0078D4" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="1"/>

        <!-- Lista zamówień -->
        <ListView ItemsSource="{Binding Orders}" Margin="10,100,10,10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <!-- Order ID -->
                        <TextBlock Text="{Binding OrderId}" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#333"/>

                        <!-- Customer Name -->
                        <TextBlock Text="{Binding CustomerName}" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#333"/>

                        <!-- Button for Details -->
                        <Button Content="Przejdź do szczegółów" 
                                Command="{Binding DataContext.ViewOrderDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" 
                                CommandParameter="{Binding}" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                Background="#4CAF50"
                                Foreground="White"
                                Padding="10"
                                BorderBrush="Transparent"
                                BorderThickness="1"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Window>
