<Window x:Class="Shop.WPF.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shop.WPF"
        mc:Ignorable="d"
        Title="ProductsWindow" Height="744" Width="800">

    <!-- Window Resources: Define button style with rounded corners and colors -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="LightBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="DarkBlue"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Delete button -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="DarkRed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Style for Add Product button -->
        <Style x:Key="AddProductButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="DarkGreen"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Lista produktów" FontSize="24" HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,10" />

        <!-- Products List -->
        <ListView ItemsSource="{Binding Products}" Grid.Row="1" Margin="0,10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding Name}" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />

                        <!-- Details Button -->
                        <Button Content="Wyświetl szczegóły" 
                                Command="{Binding DataContext.NavigateToProductDetailsCommand, 
                                          RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" 
                                CommandParameter="{Binding}" 
                                Margin="10,0,0,0"/>

                        <!-- Delete Button (with red background) -->
                        <Button Content="Delete" 
                                Command="{Binding DataContext.DeleteProductCommand, 
                                          RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" 
                                CommandParameter="{Binding}" 
                                Margin="10,0,0,0" 
                                Style="{StaticResource DeleteButtonStyle}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Add Product Form -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Vertical">
            <!-- Product Name -->
            <TextBlock Text="Product Name:" FontSize="14" Margin="0,5,0,0" />
            <TextBox Text="{Binding NewProductName}" Margin="0,5,0,10" FontSize="16"/>

            <!-- Product Price -->
            <TextBlock Text="Product Price:" FontSize="14" Margin="0,5,0,0" />
            <TextBox Text="{Binding NewProductPrice}" Margin="0,5,0,10" FontSize="16"/>

            <!-- Product Stock -->
            <TextBlock Text="Product Stock:" FontSize="14" Margin="0,5,0,0" />
            <TextBox Text="{Binding SelectedStockQuantity}" Margin="0,5,0,10" FontSize="16"/>

            <!-- Product Category -->
            <TextBlock Text="Category:" FontSize="14" Margin="0,5,0,0" />
            <ComboBox ItemsSource="{Binding Categories}" 
                      SelectedItem="{Binding SelectedCategory}" 
                      DisplayMemberPath="Name" 
                      Margin="0,5,0,10" FontSize="16"/>

            <!-- Add Product Button (with green background) -->
            <Button Content="Add Product" Command="{Binding AddProductCommand}" HorizontalAlignment="Left" 
                    Margin="0,10,0,0" Style="{StaticResource AddProductButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
