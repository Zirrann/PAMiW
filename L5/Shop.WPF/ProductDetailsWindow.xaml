<Window x:Class="Shop.WPF.ProductDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shop.WPF"
        mc:Ignorable="d"
        Title="ProductDetailsWindow" Height="450" Width="800">

    <Window.Resources>
        <!-- Style for buttons (Zielony i Szary dla przycisków) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="LightBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="DarkBlue"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Style for Save Button (Green) -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="DarkGreen"/>
        </Style>

        <!-- Style for Back Button (Gray) -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="DarkGray"/>
        </Style>
    </Window.Resources>

    <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch">
        <StackPanel Orientation="Vertical" Margin="20">

            <!-- Title -->
            <TextBlock Text="Edycja produktu" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20" FontWeight="Bold" />

            <!-- Product Name -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Nazwa:" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Width="90"/>
                <TextBox Text="{Binding Product.Name}" FontSize="18" VerticalAlignment="Center" Width="280" HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- Product Price -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Cena:" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Width="90"/>
                <TextBox Text="{Binding Product.Price}" FontSize="18" VerticalAlignment="Center" Width="280" KeyboardNavigation.TabIndex="2"/>
            </StackPanel>

            <!-- Product Quantity -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Ilość:" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Width="89"/>
                <TextBox Text="{Binding SelectedStockQuantity}" FontSize="18" VerticalAlignment="Center" Width="281"/>
            </StackPanel>

            <!-- Product Category -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Kategoria:" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Width="89"/>
                <ComboBox ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}" 
                          DisplayMemberPath="Name"
                          FontSize="18" Width="281"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Zapisz zmiany" Command="{Binding EditProductCommand}" Style="{StaticResource SaveButtonStyle}" Margin="0,10" Height="32" Width="128"/>
                <Button Content="Powrót" Command="{Binding GoBackCommand}" Style="{StaticResource BackButtonStyle}" Margin="0,10"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
