<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.MAUI.ViewModels"
             x:Class="Shop.MAUI.Views.OrderDetailsPage"
             Title="Order Details">

    <VerticalStackLayout Padding="20" Spacing="10">
        <!-- Product Selection -->
        <HorizontalStackLayout Spacing="10">
            <Label Text="Wybierz produkt:" FontSize="18" VerticalOptions="Center" />
            <Picker ItemsSource="{Binding Products}" 
                    SelectedItem="{Binding SelectedProduct}" 
                    ItemDisplayBinding="{Binding Name}" 
                    HorizontalOptions="FillAndExpand" />
            <Button Text="Dodaj produkt" 
                    Command="{Binding AddProductCommand}" 
                    FontSize="14" 
                    Padding="8,4" />
        </HorizontalStackLayout>

        <!-- Order Products Header -->
        <Label Text="Produkty w zamówieniu"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,15,0,10" />

        <!-- Order Products List -->
        <CollectionView ItemsSource="{Binding SlectedProducts}" 
              Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="LightGray" CornerRadius="10" Margin="5" Padding="10" BackgroundColor="White">
                        <StackLayout Orientation="Horizontal" Spacing="15" Padding="10">
                            <!-- Product ID -->
                            <Label Text="{Binding ProductId}" FontSize="18" VerticalOptions="Center" Padding="10" />

                            <!-- Product Name -->
                            <Label Text="{Binding Name}" FontSize="18" VerticalOptions="Center" Padding="10" />

                            <!-- Product Price -->
                            <Label Text="{Binding Price, StringFormat='{}{0:C}'}" FontSize="18" VerticalOptions="Center" Padding="10" />

                            <!-- Delete Button -->
                            <Button Text="Usuń"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OrderDetailsViewModel}}, Path=DeleteProductCommand}"
                            CommandParameter="{Binding}"
                            BackgroundColor="Red"
                            TextColor="White"
                            FontSize="14"
                            Padding="8,4"
                            VerticalOptions="Center" 
                            HorizontalOptions="End" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>



</ContentPage>
