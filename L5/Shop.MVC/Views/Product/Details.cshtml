@model ProductDetailsModel

@{
    ViewData["Title"] = "Product Details";
}

<h1>@Model.Product.Name</h1>

<div>
    <h3>Edit Product</h3>
    <!-- Formularz edycji produktu -->
    <form method="post" asp-action="Edit" asp-route-id="@Model.Product.Id">
        <!-- Ukryte pole dla product.Id -->
        <input type="hidden" asp-for="Product.Id" />

        <div class="form-group">
            <label asp-for="Product.Name">Name</label>
            <input asp-for="Product.Name" class="form-control" />
            <span asp-validation-for="Product.Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Product.Price">Price</label>
            <input asp-for="Product.Price" class="form-control" />
            <span asp-validation-for="Product.Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Product.Quantity">Stock</label>
            <input asp-for="Product.Quantity" class="form-control" />
            <span asp-validation-for="Product.Quantity" class="text-danger"></span>
        </div>

        @foreach (var category in Model.Categories)
        {
            @if (category.CategoryId == Model.Product.CategoryId)
            {
                <p>Obecna kategoria: @category.Name</p>
            }
        }

        <div class="form-group">
            <label asp-for="Product.CategoryId">Wybierz kategorię</label>
            <select asp-for="Product.CategoryId" class="form-control">
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.CategoryId">
                        @category.Name
                    </option>
                }
            </select>
            <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
        </div>
        <button type="submit">Save</button>
    </form>

    <a href="@Url.Action("Index", "Product")" class="btn btn-secondary">Back to List</a>
</div>
